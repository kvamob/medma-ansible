/system script
add dont-require-permissions=no name=script1 owner=admin policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source="/\
    tool fetch mode=https url=\"https://app.karmawifi.ru/access_points/medmasu\
    _genom_tomsk_wi_fi_1/setup.rsc\\\?token=iDlO7tZgMMXbNMTupg4zA\" dst-path=s\
    etup_medmasu_genom_tomsk_wi_fi_1.rsc\r\
    \n/import file-name=setup_medmasu_genom_tomsk_wi_fi_1.rsc"
add dont-require-permissions=no name=FetchPeriodic owner=admin policy=\
    reboot,read,write,policy,test,password,sniff,sensitive source=":global ser\
    verAvaiable\
    \n\
    \n:local activeHotspotCount [/ip hotspot print count-only where disabled=n\
    o] \
    \n:local activeUsersCount [/ip hotspot active print count-only where login\
    -by~\"^mac|trial|http-pap\\\$\"] \
    \n:local activeTrialUsersCount [/ip hotspot active print count-only where \
    login-by=trial] \
    \n:local usersCount [/ip hotspot host print count-only] \
    \n\
    \n:do {\
    \n/tool fetch mode=http url=\"http://fetch.karmawifi.ru/access_points/\$[/\
    system identity get name]/periodic\?active_users=\$activeUsersCount&hotspo\
    t=\$activeHotspotCount&token=wLV8JaCD7yS5QpunPCCe&trial_users=\$activeTria\
    lUsersCount&users=\$usersCount\" dst-path=periodic.rsc \
    \n} on-error={\
    \n        :if ([:len [/interface sstp-client find name=\"karma-sstp\"]] > \
    0) do={\
    \n/interface sstp-client set [find where name=karma-sstp] disabled=yes\
    \n:delay 2s\
    \n/interface sstp-client set [find where name=karma-sstp] disabled=no\
    \n}\
    \n/tool fetch mode=https url=\"https://app.karmawifi.ru/access_points/\$[/\
    system identity get name]/periodic\?active_users=\$activeUsersCount&hotspo\
    t=\$activeHotspotCount&token=wLV8JaCD7yS5QpunPCCe&trial_users=\$activeTria\
    lUsersCount&users=\$usersCount\" dst-path=periodic.rsc \
    \n};\
    \n\
    \n/import file-name=periodic.rsc \
    \n:set serverAvaiable true"
add dont-require-permissions=no name=CheckLogin owner=admin policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive source=":global\
    \_serverAvaiable false\
    \n:do {\
    \n/system script job remove [find where script=FetchPeriodic]\
    \n/system script run FetchPeriodic\
    \n} on-error={ };\
    \n\
    \n/ip hotspot set [ find name=hotspot-server disabled=(\$serverAvaiable) ]\
    \_disabled=(!\$serverAvaiable)\
    \n:if (\$serverAvaiable = true and [/ip dns static print count-only where \
    name=\"hotspot.medma.su\"] = 0) do={\
    \n/ip hotspot set [ find name=hotspot-server ] disabled=yes\
    \n:delay 100ms\
    \n/ip hotspot set [ find name=hotspot-server ] disabled=no\
    \n}\
    \n"
add dont-require-permissions=no name=UpdateRouterOS owner=ansible policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source="#\
    ##################\
    \n# UpdateRouterOS\
    \n###################\
    \n\
    \n# Checking the UpgradeAllowed file\
    \n# If it exists, updates are allowed\
    \n\
    \n:local fileName \"UpgradeAllowed\";\
    \n:local UpgradeAllowed;\
    \n\
    \n:if ([:len [/file find name=\$fileName]] > 0) do={\
    \n  :set \$UpgradeAllowed \"yes\";\
    \n} else={\
    \n  :set \$UpgradeAllowed \"no\";\
    \n}\
    \n\
    \n\
    \n:log info \"UpgradeAllowed: \$UpgradeAllowed\";\
    \n\
    \n:if ( \$UpgradeAllowed = \"no\" ) do={ \
    \n  :error \"Update not allowed!!!\";\
    \n}\
    \n\
    \n:log warning \"Checking new version RouterOS...\";\
    \n/system package update\
    \ncheck-for-updates once\
    \n:delay 5s;\
    \n:if ( [get status] = \"System is already up to date\") do={ \
    \n:log warning \"Installed last RouterOS version, skip upgrading\";\
    \n}\
    \n:if ( [get status] = \"New version is available\") do={ \
    \n   :log warning \"Attention! New version of RouterOS is available!\";\
    \n   :delay 2s;\
    \n   /system package update download;\
    \n   :delay 10s;\
    \n   /system package update install;\
    \n   :log warning \"Updated!!!\";\
    \n}\
    \n"
add dont-require-permissions=no name=UpgradeFirmware owner=ansible policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source="#\
    ##################\
    \n# UpgradeFirmware\
    \n###################\
    \n\
    \n# Checking the UpgradeAllowed file\
    \n# If it exists, updates are allowed\
    \n:local fileName \"UpgradeAllowed\";\
    \n:local UpgradeAllowed;\
    \n\
    \n:if ([:len [/file find name=\$fileName]] > 0) do={\
    \n  :set \$UpgradeAllowed \"yes\";\
    \n} else={\
    \n  :set \$UpgradeAllowed \"no\";\
    \n}\
    \n\
    \n:log info \"UpgradeAllowed: \$UpgradeAllowed\"\
    \n\
    \n:if ( \$UpgradeAllowed = \"no\" ) do={ \
    \n  :error \"Upgrade not allowed!!!\";\
    \n}\
    \n\
    \n:log warning \"Checking new firmware...\";\
    \n\
    \n:local currver [/system routerboard get current-firmware];\
    \n:local upgrver [/system routerboard get upgrade-firmware];\
    \n\
    \n:log info \"current-firmware: \$currver\";\
    \n:log info \"upgrade-firmware: \$upgrver\";\
    \n\
    \n:if ( \$currver = \$upgrver ) do={ \
    \n   :log warning \"Installed last firmware version, skip upgrading\";\
    \n} else={\
    \n   :log warning \"Attention! New version of firmware is available!\";\
    \n   :delay 2s;\
    \n   /system routerboard upgrade;\
    \n   /system reboot;\
    \n}\
    \n"
/caps-man manager
set enabled=yes
/caps-man provisioning
add action=create-dynamic-enabled hw-supported-modes=g,gn \
    master-configuration=cfg-hotspot-2G name-format=prefix-identity \
    name-prefix=2G slave-configurations=cfg-private-2G
add action=create-dynamic-enabled hw-supported-modes=a,ac,an \
    master-configuration=cfg-hotspot-5G name-format=prefix-identity \
    name-prefix=5G slave-configurations=cfg-private-5G
/certificate settings
set builtin-trust-store=untrusted
/interface bridge port
add bridge=LAN ingress-filtering=no interface=ether1 internal-path-cost=10 \
    path-cost=10
add bridge=LAN ingress-filtering=no interface=ether2 internal-path-cost=10 \
    path-cost=10
add bridge=LAN ingress-filtering=no interface=ether3 internal-path-cost=10 \
    path-cost=10
add bridge=LAN ingress-filtering=no interface=ether4 internal-path-cost=10 \
    path-cost=10
add bridge=LAN ingress-filtering=no interface=ether5 internal-path-cost=10 \
    path-cost=10
/ip firewall connection tracking
set udp-timeout=10s
/ip settings
set max-neighbor-entries=8192
/ipv6 settings
