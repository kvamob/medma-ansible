set caps-man-addresses=127.0.0.1 enabled=yes interfaces=wlan1,wlan2
/ip address
add address=10.70.0.3/22 interface=LAN network=10.70.0.0
add address=10.7.0.1/16 interface=bridge-hotspot network=10.7.0.0
add address=10.5.0.1/16 interface=bridge-private network=10.5.0.0
/ip dhcp-server
add address-pool=hotspot-pool interface=bridge-hotspot lease-time=10m name=\
    hotspot-dhcp
add address-pool=private-pool interface=bridge-private lease-time=10m name=\
    private-dhcp
/ip dhcp-server network
add address=10.5.0.0/16 comment="private configuration" dns-server=10.5.0.1 \
    gateway=10.5.0.1 netmask=16
add address=10.7.0.0/16 comment="hotspot configuration" dns-server=10.7.0.1 \
    gateway=10.7.0.1 netmask=16
/ip dns
set allow-remote-requests=yes servers=8.8.8.8,8.8.4.4
/ip dns static
add address=10.7.0.1 name=medmasu_genom_tomsk_wi_fi_1 type=A
add address=172.22.0.2 name=fetch.karmawifi.ru type=A
/ip firewall filter
add action=passthrough chain=unused-hs-chain comment=\
    "place hotspot rules here" disabled=yes
add action=drop chain=input comment="Drop winbox access from hotspot" \
    in-interface=bridge-hotspot port=8291 protocol=tcp
add action=drop chain=input comment="Drop winbox access from private" \
    in-interface=bridge-private port=8291 protocol=tcp
add action=drop chain=forward comment="Drop packets from hotspot to private" \
    in-interface=bridge-hotspot out-interface=bridge-private
/ip firewall mangle
add action=mark-packet chain=prerouting in-interface=bridge-hotspot \
    new-packet-mark=upload
add action=mark-packet chain=postrouting new-packet-mark=download \
    out-interface=bridge-hotspot
/ip firewall nat
add action=passthrough chain=unused-hs-chain comment=\
    "place hotspot rules here" disabled=yes
add action=masquerade chain=srcnat out-interface=LAN
/ip hotspot
add address-pool=hotspot-pool addresses-per-mac=1 disabled=no idle-timeout=\
    10m interface=bridge-hotspot keepalive-timeout=10m name=hotspot-server
/ip hotspot walled-garden
add comment="place hotspot rules here" disabled=yes
add comment="MANUAL yandex mc.yandex.ru" dst-host=mc.yandex.ru
add comment="MANUAL google *google-analytics*" dst-host=*google-analytics*
add comment="MANUAL medma wifi.medma.su" dst-host=wifi.medma.su
add comment="MANUAL medma nephroline.ru" dst-host=nephroline.ru
/ip hotspot walled-garden ip
add action=accept comment="MANUAL yandex mc.yandex.ru" disabled=no dst-host=\
